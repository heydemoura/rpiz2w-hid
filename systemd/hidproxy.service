[Unit]
Description=Network to USB HID proxy (TCP)
# Wants (not Requires): keep the TCP server up even if the gadget failed; HID
# commands then answer "ERR usb not connected to host".
Wants=hid-gadget.service
After=hid-gadget.service network.target

[Service]
EnvironmentFile=-/etc/default/hidproxy
WorkingDirectory=/opt/hidproxy
ExecStart=/usr/bin/python3 -m hidproxy
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
